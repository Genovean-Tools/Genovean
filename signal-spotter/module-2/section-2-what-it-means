      <svg viewBox="0 0 14 14" fill="none"><rect x="2" y="4" width="10" height="7" rx="1" stroke="currentColor" stroke-width="1.2"/><path d="M4 4V2h6v2" stroke="currentColor" stroke-width="1.2"/><path d="M4 9h6M4 11h4" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
      Print or Save as PDF
    </button>
    <button class="action-btn reset-btn" onclick="resetAll()">
      <svg viewBox="0 0 14 14" fill="none"><path d="M2 7a5 5 0 1 0 1-3M2 4V7h3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
