<script>
var freqs = {};
var total = 3;
var signalLabels = {
  1: 'Normal aging or something more, you can tell the difference',
  2: 'Multiple things shifting at the same time points to something underneath',
  3: 'Some signals carry more weight than others, and you can identify which'
};
function toggleCard(n) { document.getElementById('card-'+n).classList.toggle('is-open'); }
function setFreq(n,val,btn) {
  freqs[n]=val;
  var card=document.getElementById('card-'+n);
  var status=document.getElementById('status-'+n);
  btn.parentElement.querySelectorAll('.freq-btn').forEach(function(b){b.classList.remove('sel-regular','sel-yes','sel-sometimes','sel-no');});
  card.classList.remove('is-regular','is-yes','is-sometimes','is-no','is-marked');
  if(val==='regular'){btn.classList.add('sel-regular');card.classList.add('is-regular','is-marked');status.textContent='Happening regularly';}
  else if(val==='yes'){btn.classList.add('sel-yes');card.classList.add('is-yes','is-marked');status.textContent='Yes, seen this';}
  else if(val==='sometimes'){btn.classList.add('sel-sometimes');card.classList.add('is-sometimes','is-marked');status.textContent='Once or twice';}
  else{btn.classList.add('sel-no');card.classList.add('is-no','is-marked');status.textContent='Not yet';}
  updateSummary();
}
function updateSummary() {
  var r=0,y=0,s=0,n=0,marked=0,regularSignals=[];
  for(var k in freqs){marked++;if(freqs[k]==='regular'){r++;regularSignals.push(parseInt(k));}else if(freqs[k]==='yes')y++;else if(freqs[k]==='sometimes')s++;else n++;}
  document.getElementById('count-regular').textContent=r;
  document.getElementById('count-yes').textContent=y;
  document.getElementById('count-sometimes').textContent=s;
  document.getElementById('count-no').textContent=n;
  var pct=Math.round((marked/total)*100);
  document.getElementById('prog-fill').style.width=pct+'%';
  document.getElementById('prog-pct').textContent=pct+'%';
  document.getElementById('prog-text').textContent=marked+' of '+total+' signals reviewed';
  var regPanel=document.getElementById('regular-panel');
  var regList=document.getElementById('regular-list');
  if(r>0){regPanel.style.display='block';regList.innerHTML='';regularSignals.sort().forEach(function(idx){var li=document.createElement('li');li.textContent=signalLabels[idx];regList.appendChild(li);});}
  else{regPanel.style.display='none';}
  var txt='';
  if(marked===0){txt='Review the signals above and your results will appear here.';}
  else if(r>=2){txt='<strong>The interpretation work in this section is clear and significant.</strong> You have confirmed that what you are seeing goes beyond normal aging, that the signals cluster in a way that points to something underlying, and that you can identify which observations carry the most weight. That is a precise and honest picture. Carry it into Section 3 -- what you have documented here is the foundation of every decision that follows.';}
  else if(r===1&&(y+s)>=1){txt='<strong>You are building a clear interpretive picture.</strong> At least one dimension of what it means is already confirmed as a recurring pattern, and others are becoming visible. The work you have done in this section moves you from noticing to understanding. Continue to Section 3 with the notes you have written here.';}
  else if(r===1){txt='<strong>One important dimension of interpretation is confirmed.</strong> Whether it is the normal aging distinction, the clustering, or the signal weighting, having one of these clearly established is meaningful. Write as much specific detail as you can in that signal\'s notes before moving to Section 3.';}
  else if(y>=2||(y>=1&&s>=1)){txt='<strong>The interpretive picture is forming.</strong> More than one signal has been acknowledged here. You are moving from raw observation into genuine understanding of what the pattern means. The notes you have written in this section are some of the most important in the course. Continue to Section 3.';}
  else if(y===1||s>=1){txt='Something in this section has been noticed and acknowledged. That is a meaningful step. Continue building the picture in Section 3.';}
  else if(n===marked){txt='The interpretation signals have not confirmed strongly here. That is useful information, it may mean what you have observed is closer to normal aging variation than a significant pattern. Continue to Section 3 to explore what your honest next step is.';}
  else{txt='Keep working through the signals. Your picture will form as you go.';}
  document.getElementById('interpretation-text').innerHTML=txt;
}
function printGuide(){
  var w=window.open('','_blank');
  if(w){w.document.open();w.document.write(document.documentElement.outerHTML);w.document.close();w.focus();setTimeout(function(){w.print();},600);}
  else{window.print();}
}
function resetAll(){
  if(!confirm('Clear all your responses for this section and start again?'))return;
  freqs={};
  for(var i=1;i<=total;i++){
    var card=document.getElementById('card-'+i);
    card.classList.remove('is-regular','is-yes','is-sometimes','is-no','is-marked','is-open');
    document.getElementById('status-'+i).textContent='Not reviewed';
    card.querySelectorAll('.freq-btn').forEach(function(b){b.classList.remove('sel-regular','sel-yes','sel-sometimes','sel-no');});
    card.querySelectorAll('.notes-field').forEach(function(t){t.value='';});
  }
  ['count-regular','count-yes','count-sometimes','count-no'].forEach(function(id){document.getElementById(id).textContent='0';});
  document.getElementById('prog-fill').style.width='0%';
  document.getElementById('prog-pct').textContent='0%';
  document.getElementById('prog-text').textContent='0 of 3 signals reviewed';
  document.getElementById('regular-panel').style.display='none';
  document.getElementById('regular-list').innerHTML='';
  document.getElementById('interpretation-text').innerHTML='Review the signals above and your results will appear here.';
}
</script>
