<title>Signal Spotter: What It Means -- Genovean</title>
<style>
:root {
  --g-dark:    #1A3A2A;
  --g-mid:     #1D9E75;
  --g-light:   #E1F5EE;
  --g-sand:    #F5F0E8;
  --g-warm:    #C8B89A;
  --g-text:    #1C1C1A;
  --g-muted:   #5A5A56;
  --g-subtle:  #8A8A84;
  --g-border:  #D8D4C8;
  --g-white:   #FFFFFF;
  --g-amber:   #FAEEDA;
  --g-amber-t: #633806;
  --g-amber-b: #BA7517;
  --g-red-bg:  #FEF3F3;
  --g-red-bdr: #E8AAAA;
  --g-red-t:   #7A2020;
  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 14px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Georgia, 'Times New Roman', serif; background: var(--g-sand); color: var(--g-text); line-height: 1.65; font-size: 15px; }
@media print {
  body { background: #fff; font-size: 11pt; }
  .no-print { display: none !important; }
  .signal-card { break-inside: avoid; page-break-inside: avoid; }
  .header-bar { background: #1A3A2A !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .section-band { background: #E1F5EE !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .detail-body { display: block !important; }
  .freq-row { display: flex !important; }
  .notes-field { min-height: 60px !important; border: 1px solid #ccc !important; }
  .summary-panel { background: #1A3A2A !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .regular-panel { background: #7A2020 !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .save-notice { background: #FAEEDA !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .page-wrap { max-width: 100%; padding: 0; }
  a { color: inherit; text-decoration: none; }
}
